<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Helpdesk Queue</title>
<style>
:root { --bg:#f3f5f8; --panel:#fff; --border:#e3e7ec; --text:#17202a; --muted:#687386; --danger:#dc3545; --warning:#f59e0b; --success:#198754; --blue:#2563eb; --shadow:0 8px 24px rgba(15,23,42,.06); }
*{box-sizing:border-box} body{margin:0;background:var(--bg);color:var(--text);font:14px/1.45 Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
button,input,select,textarea{font:inherit} button{cursor:pointer}
.app{max-width:1280px;margin:0 auto;padding:28px 20px 40px}.topbar{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:22px}.brand h1{margin:0;font-size:28px}.brand p{margin:4px 0 0;color:var(--muted)}
.btn{border:1px solid var(--border);background:#fff;border-radius:9px;padding:9px 14px;font-weight:600}.btn.primary{background:var(--blue);color:#fff;border-color:var(--blue)}.btn.danger{color:var(--danger)}.btn:disabled{opacity:.5;cursor:not-allowed}
.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:18px}.card{background:var(--panel);border:1px solid var(--border);border-radius:12px;padding:15px;box-shadow:var(--shadow)}.card .label{color:var(--muted);font-size:12px}.card .value{font-size:27px;font-weight:750;margin-top:3px}.card.overdue .value{color:var(--danger)}.card.urgent .value{color:#b45309}
.toolbar{background:var(--panel);border:1px solid var(--border);border-radius:12px;padding:14px;box-shadow:var(--shadow);display:grid;grid-template-columns:2fr repeat(4,1fr) auto;gap:10px;align-items:center;margin-bottom:12px}.field,.select{width:100%;border:1px solid var(--border);border-radius:8px;padding:9px 10px;background:#fff}.check{display:flex;gap:7px;align-items:center;color:var(--muted);font-size:13px}.check input{width:16px;height:16px}
.tablewrap{background:#fff;border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow);overflow:auto}.meta{display:flex;justify-content:space-between;align-items:center;padding:12px 14px;color:var(--muted);font-size:13px;border-bottom:1px solid var(--border)}table{width:100%;border-collapse:collapse;min-width:900px}th,td{padding:13px 14px;border-bottom:1px solid var(--border);text-align:left;vertical-align:middle}th{font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);background:#fafbfc}tbody tr{transition:.15s}tbody tr:hover{background:#f8fafc}tbody tr.overdue{background:#fff6f6}.ticket-link{border:0;background:transparent;padding:0;text-align:left;color:var(--text);font-weight:700}.ticket-link:hover{text-decoration:underline}.customer{font-weight:650}.email{font-size:12px;color:var(--muted)}
.badge{display:inline-flex;align-items:center;border-radius:999px;padding:3px 8px;font-size:11px;font-weight:700;text-transform:uppercase}.priority-urgent{background:#fff0ed;color:#b42318}.priority-normal{background:#eef4ff;color:#1d4ed8}.status-open{background:#eff6ff;color:#1d4ed8}.status-in_progress{background:#fff7e6;color:#b45309}.status-resolved,.status-closed{background:#edf7f0;color:#157347}.sla.late{color:var(--danger);font-weight:700}.sla.near{color:#b45309;font-weight:700}.reason{font-size:11px;color:var(--muted);margin-top:4px}.actions button{margin-right:5px}
.pager{display:flex;justify-content:space-between;align-items:center;padding:12px 14px}.pagebtns{display:flex;gap:8px;align-items:center}.pagebtns button{min-width:34px}.empty{padding:48px;text-align:center;color:var(--muted)}
.modal{position:fixed;inset:0;background:rgba(15,23,42,.45);display:none;align-items:flex-start;justify-content:center;padding:50px 20px;overflow:auto;z-index:10}.modal.open{display:flex}.modal-card{width:min(620px,100%);background:#fff;border-radius:16px;box-shadow:0 20px 50px rgba(15,23,42,.2);overflow:hidden}.modal-head{padding:18px 20px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between}.modal-body{padding:20px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.grid .full{grid-column:1/-1}.form-group label{display:block;font-size:12px;font-weight:700;margin-bottom:6px}.form-group input,.form-group select,.form-group textarea{width:100%;border:1px solid var(--border);border-radius:8px;padding:9px 10px}.form-group textarea{min-height:110px;resize:vertical}.modal-foot{padding:14px 20px;border-top:1px solid var(--border);display:flex;justify-content:flex-end;gap:8px}.error{color:var(--danger);font-size:13px;margin-top:8px}
.toast{position:fixed;right:20px;bottom:20px;background:#17202a;color:#fff;padding:10px 14px;border-radius:9px;display:none;box-shadow:var(--shadow);z-index:20}.toast.show{display:block}
@media(max-width:900px){.toolbar{grid-template-columns:1fr 1fr}.cards{grid-template-columns:1fr 1fr}} @media(max-width:600px){.app{padding:18px 12px}.topbar{align-items:flex-start}.cards{grid-template-columns:1fr 1fr}.toolbar{grid-template-columns:1fr}.grid{grid-template-columns:1fr}.grid .full{grid-column:auto}}
</style>
</head>
<body>
<div class="app">
  <div class="topbar"><div class="brand"><h1>Helpdesk Queue</h1><p>Breached SLAs jump to the front. Then priority. Then the earliest deadline.</p></div><button class="btn primary" id="newTicketBtn">+ New ticket</button></div>
  <section class="cards"><div class="card"><div class="label">Open</div><div class="value" id="openCount">—</div></div><div class="card overdue"><div class="label">Overdue</div><div class="value" id="overdueCount">—</div></div><div class="card urgent"><div class="label">Urgent</div><div class="value" id="urgentCount">—</div></div><div class="card"><div class="label">In progress</div><div class="value" id="progressCount">—</div></div></section>
  <section class="toolbar">
    <input class="field" id="search" placeholder="Search ticket, customer, email or issue…" />
    <select class="select" id="priority"><option value="">All priorities</option><option value="urgent">Urgent</option><option value="normal">Normal</option></select>
    <select class="select" id="status"><option value="">All statuses</option><option value="open">Open</option><option value="in_progress">In progress</option><option value="resolved">Resolved</option><option value="closed">Closed</option></select>
    <select class="select" id="assignedTo"><option value="">All assignees</option></select>
    <label class="check"><input type="checkbox" id="overdueOnly" /> Overdue</label>
    <label class="check"><input type="checkbox" id="includeClosed" /> Show closed</label>
  </section>
  <section class="tablewrap"><div class="meta"><span id="resultMeta">Loading…</span><span id="refreshMeta">Auto-refresh: 30s</span></div><table><thead><tr><th>Customer</th><th>Issue</th><th>Priority</th><th>Status</th><th>Assigned</th><th>SLA</th><th>Action</th></tr></thead><tbody id="rows"></tbody></table><div id="emptyState" class="empty" style="display:none">No tickets match these filters.</div><div class="pager"><span id="pageLabel">—</span><div class="pagebtns"><button class="btn" id="prevBtn">← Prev</button><button class="btn" id="nextBtn">Next →</button></div></div></section>
</div>

<div class="modal" id="ticketModal"><div class="modal-card"><div class="modal-head"><strong id="modalTitle">New ticket</strong><button class="btn" id="closeModal">×</button></div><form id="ticketForm"><div class="modal-body"><div class="grid">
  <div class="form-group"><label>Customer name</label><input id="customer_name" required maxlength="120" /></div>
  <div class="form-group"><label>Customer email</label><input id="customer_email" type="email" maxlength="254" /></div>
  <div class="form-group full"><label>Issue title</label><input id="title" required maxlength="180" /></div>
  <div class="form-group full"><label>Description</label><textarea id="description" maxlength="500"></textarea></div>
  <div class="form-group"><label>Priority</label><select id="formPriority" required><option value="urgent">Urgent — 2h SLA</option><option value="normal">Normal — 24h SLA</option></select></div>
  <div class="form-group"><label>Assigned to</label><select id="formAssignee"><option value="">Unassigned</option></select></div>
  <div class="form-group"><label>Status</label><select id="formStatus"><option value="open">Open</option><option value="in_progress">In progress</option><option value="resolved">Resolved</option><option value="closed">Closed</option></select></div>
</div><div id="formError" class="error"></div></div><div class="modal-foot"><button type="button" class="btn" id="cancelBtn">Cancel</button><button type="submit" class="btn primary" id="saveBtn">Create ticket</button></div></form></div></div>
<div class="toast" id="toast"></div>
<script>
const state={page:1,pageSize:20,editingId:null,agents:[]};
const $=id=>document.getElementById(id);
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));
function toast(msg){$('toast').textContent=msg;$('toast').classList.add('show');setTimeout(()=>$('toast').classList.remove('show'),2200)}
function fmtSla(t){const mins=t.minutes_to_deadline;if(t.is_overdue)return [`Breached ${Math.abs(mins)}m ago`,'late','SLA breached'];if(mins<60)return [`${mins}m left`,mins<30?'near':'','At risk'];return [`${(mins/60).toFixed(1)}h left`,'','Within SLA']}
async function api(url,opts={}){const r=await fetch(url,{headers:{'Content-Type':'application/json',...(opts.headers||{})},...opts});let data={};try{data=await r.json()}catch{}if(!r.ok)throw new Error(data.error||'Request failed');return data}
async function loadAgents(){state.agents=await api('/api/agents');const selects=[$('assignedTo'),$('formAssignee')];selects[0].innerHTML='<option value="">All assignees</option><option value="unassigned">Unassigned</option>'+state.agents.map(a=>`<option value="${esc(a)}">${esc(a)}</option>`).join('');selects[1].innerHTML='<option value="">Unassigned</option>'+state.agents.map(a=>`<option value="${esc(a)}">${esc(a)}</option>`).join('')}
async function loadSummary(){const d=await api('/api/summary');$('openCount').textContent=d.open;$('overdueCount').textContent=d.overdue;$('urgentCount').textContent=d.urgent;$('progressCount').textContent=d.in_progress}
async function loadTickets(){try{const p=new URLSearchParams({page:state.page,pageSize:state.pageSize});[['search','search'],['priority','priority'],['status','status'],['assignedTo','assigned_to']].forEach(([a,b])=>{const v=$(a).value;if(v)p.set(b,v)});if($('overdueOnly').checked)p.set('overdue','true');if($('includeClosed').checked)p.set('include_closed','true');const d=await api('/api/tickets?'+p);$('resultMeta').textContent=`Showing ${d.total?((d.page-1)*d.pageSize+1):0}–${Math.min(d.page*d.pageSize,d.total)} of ${d.total} tickets`;$('pageLabel').textContent=`Page ${d.page} of ${d.totalPages}`;$('prevBtn').disabled=d.page<=1;$('nextBtn').disabled=d.page>=d.totalPages;$('emptyState').style.display=d.items.length?'none':'block';const tbody=$('rows');tbody.replaceChildren();for(const t of d.items){const sla=fmtSla(t);const tr=document.createElement('tr');if(t.is_overdue)tr.classList.add('overdue');tr.innerHTML=`<td><div class="customer">${esc(t.customer_name)}</div><div class="email">${esc(t.customer_email||'')}</div></td><td><button class="ticket-link" data-id="${t.id}">${esc(t.title)}</button><div class="reason">${esc(t.is_overdue?'Overdue jumps ahead':t.priority==='urgent'?'Urgent ticket':'Queued by deadline')}</div></td><td><span class="badge priority-${esc(t.priority)}">${esc(t.priority)}</span></td><td><span class="badge status-${esc(t.status)}">${esc(t.status.replace('_',' '))}</span></td><td>${esc(t.assigned_to||'Unassigned')}</td><td class="sla ${sla[1]}">${esc(sla[0])}<div class="reason">${esc(sla[2])}</div></td><td class="actions"><button class="btn" data-id="${t.id}">View / edit</button></td>`;tbody.appendChild(tr)}tbody.querySelectorAll('button[data-id]').forEach(b=>b.addEventListener('click',()=>openEdit(b.dataset.id)))}catch(e){toast(e.message)}}
function openModal(ticket){state.editingId=ticket?.id||null;$('modalTitle').textContent=state.editingId?`Ticket #${ticket.id}`:'New ticket';$('saveBtn').textContent=state.editingId?'Save changes':'Create ticket';$('customer_name').value=ticket?.customer_name||'';$('customer_email').value=ticket?.customer_email||'';$('title').value=ticket?.title||'';$('description').value=ticket?.description||'';$('formPriority').value=ticket?.priority||'urgent';$('formAssignee').value=ticket?.assigned_to||'';$('formStatus').value=ticket?.status||'open';$('formError').textContent='';$('ticketModal').classList.add('open')}
async function openEdit(id){try{openModal(await api('/api/tickets/'+id))}catch(e){toast(e.message)}}
function closeModal(){$('ticketModal').classList.remove('open');state.editingId=null}
$('newTicketBtn').onclick=()=>openModal();$('closeModal').onclick=closeModal;$('cancelBtn').onclick=closeModal;$('ticketModal').onclick=e=>{if(e.target.id==='ticketModal')closeModal()};
$('ticketForm').onsubmit=async e=>{e.preventDefault();$('formError').textContent='';const payload={customer_name:$('customer_name').value,customer_email:$('customer_email').value,title:$('title').value,description:$('description').value,priority:$('formPriority').value,assigned_to:$('formAssignee').value||null,status:$('formStatus').value};try{if(state.editingId)await api('/api/tickets/'+state.editingId,{method:'PATCH',body:JSON.stringify(payload)});else await api('/api/tickets',{method:'POST',body:JSON.stringify(payload)});closeModal();toast(state.editingId?'Ticket updated':'Ticket created');state.page=1;await Promise.all([loadSummary(),loadTickets()])}catch(e){$('formError').textContent=e.message)}};
$('prevBtn').onclick=()=>{if(state.page>1){state.page--;loadTickets()}};$('nextBtn').onclick=()=>{state.page++;loadTickets()};['search','priority','status','assignedTo','overdueOnly','includeClosed'].forEach(id=>$(id).addEventListener($(id).tagName==='INPUT'&&$(id).type==='text'?'input':'change',()=>{state.page=1;loadTickets()}));
(async()=>{await loadAgents();await Promise.all([loadSummary(),loadTickets()]);setInterval(()=>{loadSummary();loadTickets()},30000)})();
</script>
</body></html>
